# 1.5 MB app partition: Wi-Fi + TLS + telebot is ~1 MB
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# TLS client only, with the Mozilla CA bundle for api.telegram.org
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# Wi-Fi credentials come from "Example Connection Configuration" in menuconfig
CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_CONNECT_ETHERNET=n

# Telebot tuning for a small device
CONFIG_TELEBOT_MAX_RESPONSE_SIZE=32768
CONFIG_TELEBOT_DEFAULT_UPDATE_LIMIT=5
CONFIG_TELEBOT_IO_CHUNK_SIZE=1024
